<Project>
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Avalonia packages -->
        <!-- Important: keep version in sync! -->
        <PackageVersion Include="Avalonia" Version="12.1.4" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
                <PackageVersion Include="Avalonia.Android" Version="12.1.4" />
        <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />

        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

        <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />

        <!-- Kern -->
        <PackageVersion Include="Anthropic" Version="12.57.0" />
        <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
        <PackageVersion Include="PdfPig" Version="0.1.16" />
        <PackageVersion Include="AngleSharp" Version="1.8.4" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageVersion Include="WeCantSpell.Hunspell" Version="7.0.1" />
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />

        <!-- Tests -->
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
        <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    </ItemGroup>
</Project>