<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Pro Benutzer, ohne Administratorrechte; die UpgradeCode bleibt für alle Versionen gleich (ersetzt die vorige) -->
  <Package Name="Sententiam converte" Manufacturer="Jakubix-tech" Version="$(ProductVersion)"
           UpgradeCode="{6F0E3B5C-9C1A-4E7D-8B2F-3A51C7D49E26}" Scope="perUser" Language="1031" Codepage="1252">
    <SummaryInformation Description="Sententiam converte – Übersetzungsumgebung mit TM, Terminologie, QA und KI-Agenten" />

    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version von Sententiam converte ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="..\..\SententiamConverte\Assets\Icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Jakubix-tech/sententiam-converte" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Jakubix-tech/sententiam-converte" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Sententiam converte" />
      </Directory>
    </StandardDirectory>

    <!-- alles aus dem veröffentlichten Ordner (Programm, Laufzeit, Lizenzen, Dokumentation) -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(AppDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{2E8C4B71-5D3A-4F60-9A1E-7C24B8D05F13}">
        <Shortcut Id="StartMenuEntry" Name="Sententiam converte" Description="Übersetzungsumgebung mit TM, Terminologie, QA und KI-Agenten"
                  Target="[INSTALLFOLDER]SententiamConverte.Desktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\Jakubix-tech\Sententiam converte" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{9B3D6E20-1F47-4C8A-B5D2-6E0F93A7C481}">
        <Shortcut Id="DesktopEntry" Name="Sententiam converte" Description="Übersetzungsumgebung mit TM, Terminologie, QA und KI-Agenten"
                  Target="[INSTALLFOLDER]SententiamConverte.Desktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\Jakubix-tech\Sententiam converte" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Component Id="InstallFolderEntry" Directory="INSTALLFOLDER" Guid="{4C71A0E8-3B26-4D95-8F1C-A2E5D7B9036F}">
      <RegistryValue Root="HKCU" Key="Software\Jakubix-tech\Sententiam converte" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <Feature Id="Main" Title="Sententiam converte" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallFolderEntry" />
    </Feature>

    <!-- Oberfläche: Lizenz bestätigen, installieren, am Ende auf Wunsch gleich starten -->
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Sententiam converte jetzt starten" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- WixShellExec setzt den Wert erst beim Ausführen ein ([INSTALLFOLDER] ist dann bekannt) -->
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]SententiamConverte.Desktop.exe" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
