<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SententiamConverte.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Markenfarbe: das Blau des Programmsymbols -->
                <ColorPaletteResources x:Key="Light" Accent="#1F5C99" RegionColor="#FFFFFF" />
                <ColorPaletteResources x:Key="Dark" Accent="#4C8FD6" RegionColor="#1F2328" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://SententiamConverte/Themes/Theme.axaml" />
    </Application.Styles>
</Application>
