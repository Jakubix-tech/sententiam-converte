<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:SententiamConverte.Services"
             xmlns:vm="using:SententiamConverte.ViewModels"
             xmlns:agents="using:SententiamConverte.Core.Agents"
             x:Class="SententiamConverte.Views.AgentsView"
             x:DataType="vm:AgentsViewModel">
    <Grid RowDefinitions="*,Auto,Auto">
        <TabControl Padding="8">
            <!-- KI-gesteuerte Recherche -->
            <TabItem Header="{l:T 'Recherche (KI steuert)'}">
                <ScrollViewer>
                    <StackPanel Spacing="8" MaxWidth="1100" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Classes="muted"
                                   Text="{l:T 'Die KI recherchiert selbst: Sie entscheidet Schritt für Schritt, ob sie in den Projekt-Datenbanken nachschlägt, in Wikipedia, Wiktionary oder im Web sucht, einen Artikel oder eine Webseite liest, einen Skill anwendet oder sich etwas merkt – das Programm führt aus und liefert ihr die Inhalte. Seiten werden nur gelesen, wenn robots.txt und Nutzungsvorbehalte es erlauben. Funktioniert mit jeder KI, auch der kostenlosen eingebauten.'}" />
                        <TextBlock TextWrapping="Wrap" Classes="muted"
                                   Text="{l:T 'Amtliche Quellen: Gesetze aus Deutschland (Bundesrecht), Polen, dem Vereinigten Königreich und der EU (in allen Amtssprachen) sowie das DWDS fragt die KI direkt über deren Schnittstellen ab. Sie kennt die Fachseiten je Thema und Sprache (Einstellungen → Fachquellen), ergänzt neu gefundene amtliche Seiten und vergleicht Rechtsbegriffe beider Rechtsordnungen – mit Übersetzungsvorschlag und Anmerkung des Übersetzers. Für die gezielte Suche auf einzelnen Fachseiten braucht sie eine Websuche (Brave, Tavily, SearXNG oder Claude).'}" />
                        <TextBlock Text="{l:T 'Aufgabe oder Frage'}" />
                        <TextBox Text="{Binding AgentTask}" AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                 PlaceholderText="{l:T 'z. B. Wie heißt „Abkantpresse“ (Blechbearbeitung) auf Polnisch? Mit Beleg.'}" />
                        <WrapPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,4">
                                <TextBlock Text="{l:T 'Ausgangssprache'}" />
                                <TextBox Text="{Binding AgentSourceLanguage}" Width="100" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,4">
                                <TextBlock Text="{l:T 'Zielsprache(n)'}" />
                                <TextBox Text="{Binding AgentTargetLanguages}" Width="180" />
                            </StackPanel>
                            <StackPanel Spacing="4" Margin="0,0,12,4">
                                <TextBlock Text="{l:T 'Höchstens Schritte'}" />
                                <NumericUpDown Value="{Binding AgentMaxSteps}" Minimum="2" Maximum="30" Width="120" FormatString="0" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,22,0,4">
                                <CheckBox Content="{l:T 'Ergebnis im Gedächtnis speichern'}" IsChecked="{Binding AgentRemember}" />
                                <CheckBox Content="{l:T 'Neue Skills lernen'}" IsChecked="{Binding AgentLearn}" />
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{l:T 'Recherchieren'}" Command="{Binding RunAgentCommand}" Classes="accent" />
                            <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                            <TextBlock Text="{Binding AgentInfo, Converter={x:Static l:L.Text}}" VerticalAlignment="Center" Classes="muted" />
                        </StackPanel>
                        <Border Classes="card" IsVisible="{Binding AgentAnswer.Length}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{l:T 'Antwort'}" FontWeight="SemiBold" />
                                <SelectableTextBlock Text="{Binding AgentAnswer}" TextWrapping="Wrap" />
                                <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding AgentTranslation.Length}">
                                    <TextBlock Text="{l:T 'Übersetzungsvorschlag'}" FontWeight="SemiBold" />
                                    <SelectableTextBlock Text="{Binding AgentTranslation}" TextWrapping="Wrap" FontSize="15" />
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding AgentNote.Length}">
                                    <TextBlock Text="{l:T 'Anmerkung des Übersetzers (für die Leser der Übersetzung)'}" FontWeight="SemiBold" />
                                    <Border Padding="8" CornerRadius="4" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                        <SelectableTextBlock Text="{Binding AgentNote}" TextWrapping="Wrap" FontStyle="Italic" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding AgentEvidence.Length}">
                                    <TextBlock Text="{l:T 'Beleg-Prüfung (vom Programm, nicht von der KI)'}" FontWeight="SemiBold" />
                                    <SelectableTextBlock Text="{Binding AgentEvidence, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" FontSize="12.5" />
                                </StackPanel>
                                <TextBlock Text="{l:T 'Quellen'}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{Binding AgentSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="agents:SourceRef">
                                            <SelectableTextBlock Text="{Binding Url}" FontSize="12" Foreground="{DynamicResource SystemAccentColor}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Expander Header="{l:T 'Schritte der KI'}" IsVisible="{Binding AgentSteps.Count}">
                            <ItemsControl ItemsSource="{Binding AgentSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="agents:ResearchStep">
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Tool}" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColor}" />
                                                <TextBlock Text="{Binding Arguments}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" MaxWidth="800" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Thought}" FontSize="12" TextWrapping="Wrap" FontStyle="Italic" />
                                            <SelectableTextBlock Text="{Binding Observation}" FontSize="11" TextWrapping="Wrap" MaxHeight="120" Classes="muted" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Skills und Gedächtnis -->
            <TabItem Header="{l:T 'Skills &amp; Gedächtnis'}">
                <Grid ColumnDefinitions="300,16,*" Margin="0,4,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                                   Text="{l:T 'Skills sind bewährte Vorgehensweisen, die die KI bei der Recherche laden kann (offenes SKILL.md-Format). Nach erfolgreichen Recherchen legt sie selbst neue an; alle lassen sich hier lesen, ändern und löschen.'}" />
                        <ListBox ItemsSource="{Binding SkillList}" SelectedItem="{Binding SelectedSkill}" Height="320">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="agents:Skill">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding OriginText, Converter={x:Static l:L.Text}}" FontSize="11" Classes="muted" />
                                            <TextBlock Text="{Binding Uses, StringFormat='· {0}×'}" FontSize="11" Classes="muted" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel>
                            <Button Content="{l:T 'Neuer Skill'}" Command="{Binding NewSkillCommand}" Margin="0,0,6,4" />
                            <Button Content="{l:T 'Aktualisieren'}" Command="{Binding RefreshSkillsCommand}" Margin="0,0,6,4" />
                        </WrapPanel>
                        <TextBlock Text="{Binding SkillFolder}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Column="2">
                        <StackPanel Spacing="6" MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock Text="{l:T 'Name'}" />
                            <TextBox Text="{Binding SkillName}" />
                            <TextBlock Text="{l:T 'Wofür (die KI wählt danach aus)'}" />
                            <TextBox Text="{Binding SkillDescription}" TextWrapping="Wrap" />
                            <TextBlock Text="{l:T 'Vorgehen (Markdown)'}" />
                            <TextBox Text="{Binding SkillInstructions}" AcceptsReturn="True" TextWrapping="Wrap" Height="260" FontFamily="Consolas,Menlo,monospace" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{l:T 'Speichern'}" Command="{Binding SaveSkillCommand}" Classes="accent" />
                                <Button Content="{l:T 'Löschen'}" Command="{Binding DeleteSkillCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding MemoryInfo, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <Button Content="{l:T 'Gespeicherte Recherchen ansehen'}" Command="{Binding ShowMemoryCommand}" />
                            <TextBlock Text="{l:T 'In den Datenbanken nachsehen'}" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                                       Text="{l:T 'Sucht wie der Agent in TM, Terminologie, Wissen und Gedächtnis – z. B. ob eine Formulierung schon übersetzt oder ein Begriff schon recherchiert wurde. Gesucht wird in der Ausgangssprache der Recherche.'}" />
                            <Grid ColumnDefinitions="*,6,Auto">
                                <TextBox Text="{Binding DbQuery}" PlaceholderText="{l:T 'Begriff oder Formulierung'}" />
                                <Button Grid.Column="2" Content="{l:T 'Suchen'}" Command="{Binding SearchDatabasesCommand}" IsDefault="False" />
                            </Grid>
                            <SelectableTextBlock Text="{Binding DbResult, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Begriffsvergleich -->
            <TabItem Header="{l:T 'Begriffsvergleich'}">
                <ScrollViewer>
                    <StackPanel Spacing="8" MaxWidth="1100" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Classes="muted"
                                   Text="{l:T 'Für kontextabhängige Fachbegriffe, etwa im Recht: Der Assistent klärt die Bedeutung im angegebenen Zusammenhang, sucht auf den Fachseiten beider Sprachen (Fachquellen-Profil) nach Definitionen und vergleicht die Begriffe der beiden Systeme – z. B. Rechtsordnungen. Ergebnis: volle, teilweise oder keine Entsprechung, Unterschiede, empfohlene Lösung mit Begründung und überprüften Belegen.'}" />
                        <Grid ColumnDefinitions="*,12,Auto,12,Auto,12,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:T 'Begriff'}" />
                                <TextBox Text="{Binding CompareTerm}" PlaceholderText="{l:T 'z. B. Rechtsanwalt, Gewährleistung, Bescheid'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{l:T 'von'}" />
                                <TextBox Text="{Binding CompareSourceLanguage}" Width="90" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="4">
                                <TextBlock Text="{l:T 'nach'}" />
                                <TextBox Text="{Binding CompareTargetLanguage}" Width="90" />
                            </StackPanel>
                            <StackPanel Grid.Column="6" Spacing="4">
                                <TextBlock Text="{l:T 'Fachquellen'}" />
                                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding ProfileName}" MinWidth="160" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:T 'Kontext (der Satz bzw. Absatz, in dem der Begriff vorkommt)'}" />
                        <TextBox Text="{Binding CompareContext}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                        <TextBlock Text="{l:T 'Eigene Kandidaten (optional, mit Komma getrennt)'}" />
                        <TextBox Text="{Binding CompareCandidates}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{l:T 'Vergleichen'}" Command="{Binding CompareCommand}" Classes="accent" />
                            <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                            <Button Content="{l:T 'Empfehlung → Terminologie'}" Command="{Binding SaveCompareToTermbaseCommand}" IsVisible="{Binding HasCompareResult}" />
                            <Button Content="{l:T 'Begründung → Wissen'}" Command="{Binding SaveCompareToKnowledgeCommand}" IsVisible="{Binding HasCompareResult}" />
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding CompareResult, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Recherche -->
            <TabItem Header="{l:T 'Themenrecherche'}">
                <ScrollViewer>
                    <StackPanel Spacing="8" MaxWidth="1100" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Classes="muted"
                                   Text="{l:T 'Der Agent sucht zu einem Thema Fachtexte in jeder gewählten Sprache, liest sie und stellt eine mehrsprachige Begriffsliste mit Belegstellen zusammen. Gute Begriffe übernehmen Sie mit einem Klick in die Projekt-Terminologie.'}" />
                        <TextBlock Text="{l:T 'Thema / Fachgebiet'}" />
                        <TextBox Text="{Binding Topic}" PlaceholderText="{l:T 'z. B. Hydraulikpumpen – Wartung und Dichtungen'}" />
                        <Grid ColumnDefinitions="Auto,16,*,16,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:T 'Ausgangssprache'}" />
                                <TextBox Text="{Binding SourceLanguage}" Width="110" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{l:T 'Zielsprachen'}" />
                                <WrapPanel>
                                    <ItemsControl ItemsSource="{Binding TargetChoices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LanguageChoice">
                                                <CheckBox Content="{Binding Code}" IsChecked="{Binding IsChecked}" Margin="0,0,10,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBox Text="{Binding ExtraLanguages}" PlaceholderText="{l:T 'weitere, z. B. fr-FR'}" Width="170" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="4">
                                <TextBlock Text="{l:T 'Fachquellen'}" />
                                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding ProfileName}" MinWidth="150" />
                                <TextBlock Text="{l:T 'Seiten je Sprache'}" />
                                <NumericUpDown Value="{Binding PagesPerLanguage}" Minimum="1" Maximum="8" FormatString="0" Width="120" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{l:T 'Begriffe, für die Entsprechungen gesucht werden sollen (optional, einer pro Zeile)'}" VerticalAlignment="Bottom" />
                            <Button Grid.Column="1" Content="{l:T 'Aus dem Projekt vorschlagen'}" Command="{Binding SuggestSeedsFromProjectCommand}" />
                        </Grid>
                        <TextBox Text="{Binding SeedTerms}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{l:T 'Recherche starten'}" Command="{Binding ResearchCommand}" Classes="accent" />
                            <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                            <Button Content="{l:T 'Markierte in Terminologie übernehmen'}" Command="{Binding AddSelectedToTermbaseCommand}" />
                        </StackPanel>

                        <SelectableTextBlock Text="{Binding ResearchSummary, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" FontStyle="Italic" />

                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CandidateRowViewModel">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <SelectableTextBlock Text="{Binding Terms}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Definition}" TextWrapping="Wrap" Classes="muted" />
                                                <Expander Header="{l:T 'Belege'}">
                                                    <SelectableTextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="12" />
                                                </Expander>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Confidence}" Margin="8,0" ToolTip.Tip="{l:T 'Sicherheit der Zuordnung'}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="{l:T 'Gelesene Quellen'}">
                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="agents:SourceRef">
                                        <SelectableTextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Language, StringFormat='[{0}] '}" />
                                            <Run Text="{Binding Title}" />
                                            <Run Text=" – " />
                                            <Run Text="{Binding Url}" />
                                        </SelectableTextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Usus -->
            <TabItem Header="{l:T 'Usus-Prüfung'}">
                <ScrollViewer>
                    <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Classes="muted"
                                   Text="{l:T 'Ist ein Ausdruck üblich oder wird er nirgends verwendet? Der Agent sucht die genaue Wortfolge (und gleichbedeutende Alternativen) im Netz, zählt wörtliche Belege und urteilt anhand der Belege.'}" />
                        <TextBlock Text="{l:T 'Ausdruck'}" />
                        <TextBox Text="{Binding UsageExpression}" PlaceholderText="{l:T 'z. B. Anzugsdrehmoment prüfen'}" />
                        <Grid ColumnDefinitions="Auto,16,*">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:T 'Sprache'}" />
                                <TextBox Text="{Binding UsageLanguage}" Width="110" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{l:T 'Alternativen zum Vergleich (optional, je Zeile; leer = KI schlägt vor)'}" />
                                <TextBox Text="{Binding UsageAlternatives}" AcceptsReturn="True" Height="70" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{l:T 'Prüfen'}" Command="{Binding CheckUsageCommand}" Classes="accent" />
                            <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding UsageResult, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Bewertung -->
            <TabItem Header="{l:T 'Übersetzungen bewerten'}">
                <ScrollViewer>
                    <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Classes="muted"
                                   Text="{l:T 'Mehrere Übersetzungen eines Satzes vergleichen: Richtigkeit, Sprachfluss, Terminologie und Stil, mit Begründung und Verbesserungsvorschlag.'}" />
                        <TextBlock Text="{l:T 'Quelltext'}" />
                        <TextBox Text="{Binding EvalSource}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                        <TextBlock Text="{l:T 'Übersetzungen (eine pro Zeile)'}" />
                        <TextBox Text="{Binding EvalCandidates}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{l:T 'Zielsprache'}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding EvalTargetLanguage}" Width="110" />
                            <CheckBox Content="{l:T 'Fragliche Wendungen im Netz prüfen'}" IsChecked="{Binding EvalCheckUsage}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{l:T 'Bewerten'}" Command="{Binding EvaluateCommand}" Classes="accent" />
                            <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding EvalResult, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsRunning}" />
        <Expander Grid.Row="2" Header="{l:T 'Protokoll der Agenten'}" IsExpanded="True" Margin="8,4">
            <ScrollViewer MaxHeight="180">
                <SelectableTextBlock Text="{Binding Log, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" FontSize="12" />
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
