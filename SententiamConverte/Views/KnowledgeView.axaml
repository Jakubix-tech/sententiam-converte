<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:SententiamConverte.Services"
             xmlns:vm="using:SententiamConverte.ViewModels"
             xmlns:kb="using:SententiamConverte.Core.Resources"
             x:Class="SententiamConverte.Views.KnowledgeView"
             x:DataType="vm:KnowledgeViewModel">
    <TabControl Padding="8">
        <TabItem Header="{l:T 'Durchsuchen'}">
            <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,12,380">
                <WrapPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedBase}" MinWidth="240" Margin="0,0,8,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="kb:IKnowledgeBase">
                                <TextBlock Text="{Binding Location}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding Filter}" PlaceholderText="{l:T 'Suchen …'}" Width="260" Margin="0,0,8,4" />
                    <TextBox Text="{Binding LanguageFilter}" PlaceholderText="{l:T 'Sprache (leer = alle)'}" Width="150" Margin="0,0,8,4" />
                    <Button Content="{l:T 'Aktualisieren'}" Command="{Binding LoadCommand}" Margin="0,0,8,4" />
                    <Button Content="{l:T 'Neuer Eintrag'}" Command="{Binding NewEntryCommand}" Margin="0,0,8,4" />
                </WrapPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:KnowledgeRow">
                            <StackPanel Spacing="2" Margin="0,2">
                                <TextBlock Text="{Binding Header, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.6" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Quote}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.75" IsVisible="{Binding Quote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer Grid.Row="1" Grid.Column="2">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:T 'Eintrag'}" FontWeight="SemiBold" FontSize="16" />
                        <Grid ColumnDefinitions="*,8,*">
                            <TextBox Text="{Binding EditLanguage}" PlaceholderText="{l:T 'Sprache, z. B. de-DE'}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding KindNames}" SelectedIndex="{Binding EditKind}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TextBox Text="{Binding EditTopic}" PlaceholderText="{l:T 'Thema'}" />
                        <TextBox Text="{Binding EditTitle}" PlaceholderText="{l:T 'Titel'}" />
                        <TextBox Text="{Binding EditContent}" PlaceholderText="{l:T 'Inhalt'}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                        <TextBox Text="{Binding EditSource}" PlaceholderText="{l:T 'Quelle (Adresse, optional)'}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{l:T 'Speichern'}" Command="{Binding SaveEntryCommand}" Classes="accent" />
                            <Button Content="{l:T 'Löschen'}" Command="{Binding DeleteEntryCommand}" CommandParameter="{x:Null}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <TabItem Header="{l:T 'Wissens-Agent'}">
            <ScrollViewer>
                <StackPanel Spacing="8" MaxWidth="1000" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="{l:T 'Der Agent sucht zum Thema in jeder gewählten Sprache verlässliche Quellen, liest sie und legt Wissenseinträge mit wörtlichem Beleg in der oben gewählten Wissensdatenbank an. Einträge, deren Beleg nicht wirklich auf der Seite steht, werden verworfen. Seiten, die das Auslesen per robots.txt oder Nutzungsvorbehalt untersagen, werden übersprungen.'}" />
                    <TextBlock Text="{l:T 'Ziel-Datenbank'}" />
                    <ComboBox ItemsSource="{Binding Bases}" SelectedItem="{Binding SelectedBase}" MinWidth="300">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="kb:IKnowledgeBase">
                                <TextBlock Text="{Binding Location}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{l:T 'Thema'}" />
                    <TextBox Text="{Binding AgentTopic}" PlaceholderText="{l:T 'z. B. Kreiselpumpen – Wartung, Dichtungen, Normen'}" />
                    <TextBlock Text="{l:T 'Schwerpunkt / offene Fragen (optional)'}" />
                    <TextBox Text="{Binding AgentFocus}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                    <TextBlock Text="{l:T 'Sprachen'}" />
                    <ItemsControl ItemsSource="{Binding AgentLanguages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageChoice">
                                <CheckBox Content="{Binding Code}" IsChecked="{Binding IsChecked}" Margin="0,0,12,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{l:T 'Seiten je Sprache'}" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding AgentPages}" Minimum="1" Maximum="8" FormatString="0" Width="120" />
                        <Button Content="{l:T 'Agent starten'}" Command="{Binding RunAgentCommand}" Classes="accent" />
                        <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" />
                    <SelectableTextBlock Text="{Binding Log, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{l:T 'Team-Aktivität'}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Button Content="{l:T 'Aktualisieren'}" Command="{Binding LoadActivityCommand}" />
                    <TextBlock Text="{l:T 'Was das Team zuletzt zu TMs, Terminologien und Wissensdatenbanken beigetragen hat.'}" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Activity}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityRow">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" FontSize="12" Opacity="0.65" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
