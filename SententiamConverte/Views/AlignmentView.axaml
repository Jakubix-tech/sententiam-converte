<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:SententiamConverte.Services"
             xmlns:vm="using:SententiamConverte.ViewModels"
             xmlns:c="using:SententiamConverte.Controls"
             x:Class="SententiamConverte.Views.AlignmentView"
             x:DataType="vm:AlignmentViewModel">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="{l:T '← Zurück'}" Command="{Binding CloseCommand}" />
                <TextBlock Text="{l:T 'Alignment-Editor'}" Classes="h1" VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel>
                <Button Content="{l:T 'Ausgangstext …'}" Command="{Binding PickSourceCommand}" Margin="0,0,6,4" />
                <TextBlock Text="{Binding SourceName}" VerticalAlignment="Center" Margin="0,0,6,4" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                <c:LanguagePicker Value="{Binding SourceLanguage}" Width="210" Margin="0,0,16,4" />
                <Button Content="{l:T 'Übersetzung …'}" Command="{Binding PickTargetCommand}" Margin="0,0,6,4" />
                <TextBlock Text="{Binding TargetName}" VerticalAlignment="Center" Margin="0,0,6,4" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                <c:LanguagePicker Value="{Binding TargetLanguage}" Width="210" Margin="0,0,16,4" />
                <Button Content="{l:T 'Ausrichten'}" Command="{Binding AlignCommand}" Classes="accent" Margin="0,0,6,4" />
            </WrapPanel>
            <WrapPanel>
                <Button Content="{l:T 'Automatisch mit KI'}" Command="{Binding AiAutoCommand}" Margin="0,0,6,4"
                        ToolTip.Tip="{l:T 'Die KI prüft jedes Paar, richtet unsichere Abschnitte nach dem Sinn neu aus und prüft das Ergebnis noch einmal. Bestätigte Paare bleiben unverändert.'}" />
                <Button Content="{l:T 'KI prüft Paare'}" Command="{Binding AiCheckCommand}" Margin="0,0,6,4" />
                <Button Content="{l:T 'KI: Unsicheres neu ausrichten'}" Command="{Binding AiFixCommand}" Margin="0,0,6,4" />
                <Button Content="{l:T 'Neu ausrichten (bestätigte bleiben)'}" Command="{Binding RealignCommand}" Margin="0,0,6,4" />
                <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="0,0,6,4" />
                <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
            </WrapPanel>
            <WrapPanel>
                <CheckBox Content="{l:T 'Formatierung als Tags übernehmen'}" IsChecked="{Binding KeepTags}" Margin="0,0,12,4"
                          ToolTip.Tip="{l:T 'Die Tags der Übersetzung werden an die des Ausgangssatzes angeglichen, damit TM-Treffer später die Formatierung mitbringen.'}" />
                <TextBlock Text="{l:T 'Ziel-TM:'}" VerticalAlignment="Center" Margin="0,0,6,4" />
                <ComboBox ItemsSource="{Binding Tms}" SelectedItem="{Binding TargetTm}" MinWidth="240" Margin="0,0,6,4" />
                <Button Content="{l:T 'Neue TM für dieses Sprachpaar'}" Command="{Binding NewPairTmCommand}" Margin="0,0,6,4" />
                <Button Content="{l:T 'Ausgewählte ins TM'}" Command="{Binding ImportCommand}" Classes="accent" Margin="0,0,6,4" />
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                       Text="{l:T 'Jede Zeile im Textfeld ist ein Satz: Ein Zeilenumbruch teilt einen Satz, das Löschen eines Umbruchs verbindet zwei. ↑/↓ verschiebt den ersten bzw. letzten Satz ins vorige bzw. nächste Paar. Gelb = unsicher. Bestätigte Paare bleiben beim Neu-Ausrichten als feste Anker stehen.'}" />
            <SelectableTextBlock Text="{Binding Info, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AlignPairRow">
                    <Border Padding="4" CornerRadius="4" Classes.uncertain="{Binding IsUncertain}">
                        <Border.Styles>
                            <Style Selector="Border.uncertain">
                                <Setter Property="Background" Value="#FFF4D6" />
                            </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="Auto,34,*,Auto,*,Auto,170">
                            <CheckBox IsChecked="{Binding Accepted}" VerticalAlignment="Top" ToolTip.Tip="{l:T 'ins TM übernehmen'}" />
                            <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="muted" Margin="4,6,0,0" />
                            <TextBox Grid.Column="2" Text="{Binding SourceText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" />
                            <StackPanel Grid.Column="3" Spacing="2" Margin="2,0">
                                <Button Content="↑" Padding="6,0" ToolTip.Tip="{l:T 'ersten Ausgangssatz ins vorige Paar'}"
                                        Command="{Binding $parent[UserControl].((vm:AlignmentViewModel)DataContext).SourceUpCommand}" CommandParameter="{Binding}" />
                                <Button Content="↓" Padding="6,0" ToolTip.Tip="{l:T 'letzten Ausgangssatz ins nächste Paar'}"
                                        Command="{Binding $parent[UserControl].((vm:AlignmentViewModel)DataContext).SourceDownCommand}" CommandParameter="{Binding}" />
                            </StackPanel>
                            <TextBox Grid.Column="4" Text="{Binding TargetText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" />
                            <StackPanel Grid.Column="5" Spacing="2" Margin="2,0">
                                <Button Content="↑" Padding="6,0" ToolTip.Tip="{l:T 'ersten Zielsatz ins vorige Paar'}"
                                        Command="{Binding $parent[UserControl].((vm:AlignmentViewModel)DataContext).TargetUpCommand}" CommandParameter="{Binding}" />
                                <Button Content="↓" Padding="6,0" ToolTip.Tip="{l:T 'letzten Zielsatz ins nächste Paar'}"
                                        Command="{Binding $parent[UserControl].((vm:AlignmentViewModel)DataContext).TargetDownCommand}" CommandParameter="{Binding}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6" Spacing="3" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Quality}" FontSize="12" Classes="muted" ToolTip.Tip="{Binding Note}" />
                                <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Foreground="#9C4221"
                                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <WrapPanel>
                                    <ToggleButton Content="✓" IsChecked="{Binding Confirmed}" Padding="6,0" Margin="0,0,3,3" ToolTip.Tip="{l:T 'bestätigen (fester Anker)'}" />
                                    <Button Content="{l:T 'Verbinden ↓'}" Padding="6,0" Margin="0,0,3,3" ToolTip.Tip="{l:T 'mit dem nächsten Paar verbinden'}"
                                            Command="{Binding $parent[UserControl].((vm:AlignmentViewModel)DataContext).MergeWithNextCommand}" CommandParameter="{Binding}" />
                                    <Button Content="{l:T 'Teilen'}" Padding="6,0" Margin="0,0,3,3" ToolTip.Tip="{l:T 'in einzelne Paare teilen (Satz für Satz)'}"
                                            Command="{Binding $parent[UserControl].((vm:AlignmentViewModel)DataContext).SplitCommand}" CommandParameter="{Binding}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
