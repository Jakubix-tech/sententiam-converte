<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:SententiamConverte.Services"
             xmlns:vm="using:SententiamConverte.ViewModels"
             xmlns:c="using:SententiamConverte.Controls"
             x:Class="SententiamConverte.Views.EditorView"
             x:DataType="vm:EditorViewModel">
    <UserControl.Styles>
        <Style Selector="TabControl.side TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="StackPanel.toolbar > Button, StackPanel.toolbar > ToggleButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Werkzeugleiste: eine Zeile, auf schmalen Bildschirmen seitlich verschiebbar -->
        <Border Padding="8,6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding DocumentTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="8,0,0,0">
                        <TextBlock Text="{Binding SyncInfo, Converter={x:Static l:L.Text}}" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding Progress, Converter={x:Static l:L.Text}}" VerticalAlignment="Center" Opacity="0.8" />
                    </StackPanel>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Classes="toolbar" Margin="0,0,0,4">
                        <ComboBox ItemsSource="{Binding FilterNames}" SelectedIndex="{Binding FilterIndex}" Width="170" Margin="0,0,6,0" />
                        <Button Content="{l:T '✔ Bestätigen'}" ToolTip.Tip="{l:T 'Strg+Eingabe: bestätigen, ins TM schreiben, weiter'}" Command="{Binding ConfirmAndNextCommand}" Classes="accent" />
                        <Button Content="{l:T 'Lektoriert'}" ToolTip.Tip="{l:T 'Strg+Alt+Eingabe'}" Command="{Binding SetReviewedCommand}" />
                        <Button Content="{l:T 'Ablehnen'}" Command="{Binding RejectCommand}" />
                        <Button Content="{l:T 'Quelle → Ziel'}" ToolTip.Tip="{l:T 'Strg+Einfg'}" Command="{Binding CopySourceCommand}" />
                        <Button Content="{l:T 'Leeren'}" ToolTip.Tip="{l:T 'Strg+Entf'}" Command="{Binding ClearTargetCommand}" />
                        <Button Content="{l:T 'Teilen'}" ToolTip.Tip="{l:T 'Alt+T: Segment an der Cursorposition im Quelltext teilen'}" Click="OnSplitClick" IsEnabled="{Binding CanResegment}" />
                        <Button Content="{l:T 'Zusammenführen'}" ToolTip.Tip="{l:T 'Alt+Z: mit dem folgenden Segment zusammenführen'}" Command="{Binding MergeWithNextCommand}" IsEnabled="{Binding CanResegment}" />
                        <Button Content="{l:T 'KI übersetzen'}" ToolTip.Tip="{l:T 'Strg+Umschalt+T'}" Command="{Binding AiTranslateCommand}" />
                        <Button Content="{l:T 'Leere per KI'}" ToolTip.Tip="{l:T 'Alle leeren Segmente als Entwurf per KI übersetzen'}" Command="{Binding AiTranslateAllCommand}" />
                        <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelAiCommand}" IsVisible="{Binding IsAiRunning}" />
                        <Button Content="{l:T 'QA'}" Command="{Binding RunQaCommand}" />
                        <Button Content="{l:T 'Vorschau'}" ToolTip.Tip="{l:T 'Zieldatei erzeugen und öffnen'}" Command="{Binding PreviewCommand}" />
                        <Button Content="{l:T 'Speichern'}" ToolTip.Tip="{l:T 'Strg+S'}" Command="{Binding SaveCommand}" />
                        <ToggleButton x:Name="FindToggle" Content="{l:T 'Suchen/Ersetzen'}" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Suchen und Ersetzen -->
        <Border Grid.Row="1" Padding="8,4" IsVisible="{Binding #FindToggle.IsChecked}">
            <WrapPanel>
                <TextBox Text="{Binding FindText}" PlaceholderText="{l:T 'Suchen im Ziel'}" Width="220" Margin="0,0,6,4" />
                <TextBox Text="{Binding ReplaceText}" PlaceholderText="{l:T 'Ersetzen durch'}" Width="220" Margin="0,0,6,4" />
                <Button Content="{l:T 'Alle ersetzen'}" Command="{Binding ReplaceAllCommand}" Margin="0,0,6,4" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" x:Name="Split" ColumnDefinitions="*,Auto,420">
            <ListBox x:Name="SegmentList" ItemsSource="{Binding Segments}" SelectedItem="{Binding Selected}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SegmentViewModel">
                        <Grid ColumnDefinitions="38,*,*,76">
                            <StackPanel>
                                <TextBlock Text="{Binding Id}" Opacity="0.6" FontSize="12" />
                                <TextBlock Text="⚠" Foreground="#C53030" IsVisible="{Binding HasIssues}" ToolTip.Tip="{l:T 'QA-Meldungen'}" />
                                <TextBlock Text="✎" Opacity="0.7" IsVisible="{Binding HasComment}" ToolTip.Tip="{Binding Model.Comment}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <SelectableTextBlock c:TagHighlight.Text="{Binding Source}" TextWrapping="Wrap" Margin="2,4" />
                                <TextBlock Text="{Binding Context}" FontSize="11" Opacity="0.5" Margin="2,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBox Text="{Binding Target}" TextWrapping="Wrap" AcceptsReturn="False"
                                         IsReadOnly="{Binding IsReadOnly}" MinHeight="32" GotFocus="OnTargetFocused" TextChanged="OnTargetTextChanged" />
                                <TextBlock c:TagHighlight.Text="{Binding Target}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="4,2,0,0"
                                           IsVisible="{Binding HasTargetTags}" />
                                <TextBlock Text="{Binding MissingTags, Converter={x:Static l:L.Text}}" FontSize="11" Foreground="#C53030" Margin="4,0,0,0"
                                           IsVisible="{Binding MissingTags, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="6,2,0,0" Spacing="2">
                                <Border Background="{Binding StatusBrush}" CornerRadius="3" Padding="4,1">
                                    <TextBlock Text="{Binding StatusText, Converter={x:Static l:L.Text}}" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding OriginText, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding LockText, Converter={x:Static l:L.Text}}" FontSize="11" Foreground="#B7791F" HorizontalAlignment="Center" TextWrapping="Wrap"
                                           IsVisible="{Binding LockText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" ResizeDirection="Columns" />

            <!-- Seitenleiste -->
            <TabControl x:Name="SidePanel" Grid.Column="2" Classes="side" SelectedIndex="{Binding SidePanelTab}" Padding="4">
                <TabItem Header="{l:T 'TM'}">
                    <ScrollViewer>
                        <StackPanel Spacing="6">
                            <ItemsControl ItemsSource="{Binding Matches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchRow">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,4">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock FontWeight="Bold" VerticalAlignment="Center"><Run Text="{l:T 'Strg+'}" /><Run Text="{Binding Number}" /></TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding Score}" Margin="8,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Content="{l:T 'Einsetzen'}" Padding="6,1"
                                                            Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).ApplyMatchCommand}"
                                                            CommandParameter="{Binding Number}" />
                                                </Grid>
                                                <TextBlock c:TagHighlight.Text="{Binding Source}" TextWrapping="Wrap" Opacity="0.75" />
                                                <TextBlock c:TagHighlight.Text="{Binding Target}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Info, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ContextText, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" FontStyle="Italic"
                                                           IsVisible="{Binding ContextText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:T 'Fragment-Treffer'}" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock Text="{l:T 'Kürzere TM-Einträge, die vollständig in diesem Segment vorkommen.'}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Fragments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FragmentRow">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Phrase}" TextWrapping="Wrap" Opacity="0.75" />
                                                <TextBlock Text="{Binding Target}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="+" VerticalAlignment="Top" ToolTip.Tip="{l:T 'Ins Ziel einfügen'}"
                                                    Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).InsertFragmentCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:T 'Termini'}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="2,6"
                                   Text="{l:T 'Strg+F2: markierten Quelltext und markierten Zieltext als Begriff aufnehmen.'}" />
                        <ListBox ItemsSource="{Binding Terms}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TermRow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Targets}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Definition}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+" VerticalAlignment="Top" ToolTip.Tip="{l:T 'Ins Ziel einfügen'}"
                                                Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).InsertTermCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{l:T 'Konkordanz'}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="4">
                            <TextBox Text="{Binding ConcordanceQuery}" PlaceholderText="{l:T 'Ausdruck (F3: markierten Text suchen)'}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="{l:T 'im Ziel suchen'}" IsChecked="{Binding ConcordanceInTarget}" />
                                <Button Content="{l:T 'Suchen'}" Command="{Binding SearchConcordanceCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Concordance}" Margin="0,6,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConcordanceRow">
                                    <StackPanel Spacing="1">
                                        <TextBlock c:TagHighlight.Text="{Binding Source}" TextWrapping="Wrap" Opacity="0.75" />
                                        <TextBlock c:TagHighlight.Text="{Binding Target}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Info, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{l:T 'QA'}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <Button Content="{l:T 'Dokument prüfen'}" Command="{Binding RunQaCommand}" />
                            <Button Content="{l:T 'Rechtschreibung (Segment)'}" Command="{Binding CheckSpellingCommand}" />
                        </StackPanel>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SpellingErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpellRow">
                                    <StackPanel Margin="0,0,0,6" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Word}" FontWeight="SemiBold" Foreground="#C53030" VerticalAlignment="Center" />
                                            <Button Content="{l:T 'ins Wörterbuch'}" Padding="6,1" FontSize="12"
                                                    Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).AddToDictionaryCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Suggestions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SuggestionItem">
                                                    <Button Content="{Binding Replacement}" Padding="6,1" Margin="0,0,4,4" FontSize="12"
                                                            Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).ApplySpellingCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ListBox ItemsSource="{Binding QaIssues}" x:Name="QaList" DoubleTapped="OnQaDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:QaRow">
                                    <StackPanel Spacing="1">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding SegmentId, StringFormat='Segment {0}'}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Severity, Converter={x:Static l:L.Text}}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Check, Converter={x:Static l:L.Text}}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{l:T 'Wissen'}">
                    <ScrollViewer>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:T 'Passendes aus den Wissensdatenbanken – geht auch in jede KI-Übersetzung ein.'}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Knowledge}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KnowledgeRow">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Header, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.6" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:T 'Notiz'}">
                    <ScrollViewer>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{l:T 'Kommentar zum Segment'}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                            <TextBlock Text="{l:T 'Verlauf'}" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="{l:T 'Jede bestätigte Fassung; Änderungen als [−gelöscht−] {+eingefügt+}.'}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryRow">
                                        <StackPanel Margin="0,4" Spacing="1">
                                            <TextBlock Text="{Binding Header, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.6" />
                                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <SelectableTextBlock Text="{Binding Diff}" TextWrapping="Wrap" FontSize="12" Foreground="#2B6CB0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:T 'KI'}">
                    <ScrollViewer>
                        <StackPanel Spacing="6">
                            <WrapPanel>
                                <Button Content="{l:T 'Übersetzen'}" Command="{Binding AiTranslateCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Varianten bewerten'}" ToolTip.Tip="{l:T 'Strg+Umschalt+E: aktuelle Übersetzung, TM-Treffer und KI-Vorschlag vergleichen'}"
                                        Command="{Binding EvaluateSegmentCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Usus prüfen'}" ToolTip.Tip="{l:T 'Strg+Umschalt+U: markierten Zieltext (oder ganze Übersetzung) im Netz prüfen'}"
                                        Command="{Binding CheckUsageOfTargetCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Beste übernehmen'}" Command="{Binding UseBestEvaluatedCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Begriff im Kontext klären'}" Click="OnClarifyTermClick" Margin="0,0,6,4"
                                        ToolTip.Tip="{l:T 'Strg+Umschalt+B: markierten Begriff im Quelltext auf Fachseiten beider Sprachen vergleichen'}" />
                            </WrapPanel>
                            <WrapPanel IsVisible="{Binding HasComparison}">
                                <Button Content="{l:T 'Empfehlung → Terminologie'}" Command="{Binding SaveComparisonToTermbaseCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Begründung → Wissen'}" Command="{Binding SaveComparisonToKnowledgeCommand}" Margin="0,0,6,4" />
                            </WrapPanel>
                            <CheckBox Content="{l:T 'Fragliche Wendungen beim Bewerten im Netz prüfen'}" IsChecked="{Binding AiCheckUsage}" />
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAiRunning}" />
                            <SelectableTextBlock Text="{Binding AiResult, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" />
                            <Expander Header="{l:T 'Protokoll'}">
                                <SelectableTextBlock Text="{Binding AiLog, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- AutoSuggest -->
        <Popup x:Name="SuggestPopup" Grid.Row="2" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="2">
                <ListBox x:Name="SuggestList" MaxHeight="220" MinWidth="200" Tapped="OnSuggestionTapped" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
