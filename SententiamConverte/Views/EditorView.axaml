<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:SententiamConverte.Services"
             xmlns:vm="using:SententiamConverte.ViewModels"
             xmlns:c="using:SententiamConverte.Controls"
             x:Class="SententiamConverte.Views.EditorView"
             x:DataType="vm:EditorViewModel">
    <UserControl.Styles>
        <Style Selector="TabControl.side TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="StackPanel.toolbar > Button, StackPanel.toolbar > ToggleButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Werkzeugleiste wie in einer Textverarbeitung: Titel und Fortschritt, darunter Befehle in Gruppen -->
        <Border Classes="toolbar">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,2">
                    <TextBlock Text="{Binding DocumentTitle}" Classes="h2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="8,0,0,0">
                        <TextBlock Text="{Binding SyncInfo, Converter={x:Static l:L.Text}}" VerticalAlignment="Center" Classes="muted" FontSize="12" />
                        <TextBlock Text="{Binding Progress, Converter={x:Static l:L.Text}}" VerticalAlignment="Center" Classes="muted" />
                    </StackPanel>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tool accent" Command="{Binding ConfirmAndNextCommand}" ToolTip.Tip="{l:T 'Strg+Eingabe: bestätigen, ins TM schreiben, weiter'}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Ic.Confirm}" />
                                <TextBlock Text="{l:T 'Bestätigen'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool" Command="{Binding SetReviewedCommand}" ToolTip.Tip="{l:T 'Strg+Alt+Eingabe'}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Ic.Reviewed}" />
                                <TextBlock Text="{l:T 'Lektoriert'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool" Command="{Binding RejectCommand}" ToolTip.Tip="{l:T 'Ablehnen'}">
                            <PathIcon Data="{StaticResource Ic.Reject}" />
                        </Button>
                        <Rectangle Classes="sep" />
                        <Button Classes="tool" Click="OnUndoClick" ToolTip.Tip="{l:T 'Rückgängig (Strg+Z)'}"><PathIcon Data="{StaticResource Ic.Undo}" /></Button>
                        <Button Classes="tool" Click="OnRedoClick" ToolTip.Tip="{l:T 'Wiederholen (Strg+Y)'}"><PathIcon Data="{StaticResource Ic.Redo}" /></Button>
                        <Rectangle Classes="sep" />
                        <Button Classes="tool" Click="OnBoldClick" ToolTip.Tip="{l:T 'Fett (Strg+B) – setzt die fette Formatierung der Quelle'}"><PathIcon Data="{StaticResource Ic.Bold}" /></Button>
                        <Button Classes="tool" Click="OnItalicClick" ToolTip.Tip="{l:T 'Kursiv (Strg+I)'}"><PathIcon Data="{StaticResource Ic.Italic}" /></Button>
                        <Button Classes="tool" Click="OnUnderlineClick" ToolTip.Tip="{l:T 'Unterstrichen (Strg+U)'}"><PathIcon Data="{StaticResource Ic.Underline}" /></Button>
                        <Button Classes="tool" Click="OnInsertTagClick" ToolTip.Tip="{l:T 'Nächstes fehlendes Tag einsetzen (Strg+Umschalt+G)'}"><PathIcon Data="{StaticResource Ic.Tag}" /></Button>
                        <Rectangle Classes="sep" />
                        <Button Classes="tool" Command="{Binding CopySourceCommand}" ToolTip.Tip="{l:T 'Quelle ins Ziel kopieren (Strg+Einfg)'}"><PathIcon Data="{StaticResource Ic.CopySource}" /></Button>
                        <Button Classes="tool" Command="{Binding ClearTargetCommand}" ToolTip.Tip="{l:T 'Ziel leeren (Strg+Entf)'}"><PathIcon Data="{StaticResource Ic.Clear}" /></Button>
                        <Button Classes="tool" Click="OnSplitClick" IsEnabled="{Binding CanResegment}" ToolTip.Tip="{l:T 'Alt+T: Segment an der Cursorposition im Quelltext teilen'}"><PathIcon Data="{StaticResource Ic.Split}" /></Button>
                        <Button Classes="tool" Command="{Binding MergeWithNextCommand}" IsEnabled="{Binding CanResegment}" ToolTip.Tip="{l:T 'Alt+Z: mit dem folgenden Segment zusammenführen'}"><PathIcon Data="{StaticResource Ic.Merge}" /></Button>
                        <Rectangle Classes="sep" />
                        <Button Classes="tool" Command="{Binding AiTranslateCommand}" ToolTip.Tip="{l:T 'Strg+Umschalt+T'}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Ic.Ai}" />
                                <TextBlock Text="{l:T 'KI übersetzen'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool" Command="{Binding AiTranslateAllCommand}" ToolTip.Tip="{l:T 'Alle leeren Segmente als Entwurf per KI übersetzen'}">
                            <TextBlock Text="{l:T 'Leere per KI'}" VerticalAlignment="Center" />
                        </Button>
                        <Button Classes="tool" Command="{Binding CancelAiCommand}" IsVisible="{Binding IsAiRunning}" ToolTip.Tip="{l:T 'Abbrechen'}"><PathIcon Data="{StaticResource Ic.Stop}" /></Button>
                        <Rectangle Classes="sep" />
                        <ToggleButton Classes="tool" IsChecked="{Binding SpellCheckEnabled}" ToolTip.Tip="{l:T 'Rechtschreibfehler beim Tippen unterstreichen'}"><PathIcon Data="{StaticResource Ic.Spelling}" /></ToggleButton>
                        <Button Classes="tool" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{l:T 'Kleiner'}"><PathIcon Data="{StaticResource Ic.ZoomOut}" /></Button>
                        <Button Classes="tool" Command="{Binding ZoomInCommand}" ToolTip.Tip="{l:T 'Größer'}"><PathIcon Data="{StaticResource Ic.ZoomIn}" /></Button>
                        <Rectangle Classes="sep" />
                        <Button Classes="tool" Command="{Binding RunQaCommand}" ToolTip.Tip="{l:T 'Dokument prüfen'}"><PathIcon Data="{StaticResource Ic.Qa}" /></Button>
                        <Button Classes="tool" Command="{Binding PreviewCommand}" ToolTip.Tip="{l:T 'Zieldatei erzeugen und öffnen'}"><PathIcon Data="{StaticResource Ic.Preview}" /></Button>
                        <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="{l:T 'Speichern (Strg+S)'}"><PathIcon Data="{StaticResource Ic.Save}" /></Button>
                        <ToggleButton Classes="tool" x:Name="FindToggle" ToolTip.Tip="{l:T 'Suchen/Ersetzen'}"><PathIcon Data="{StaticResource Ic.Search}" /></ToggleButton>
                        <Rectangle Classes="sep" />
                        <ComboBox ItemsSource="{Binding FilterNames}" SelectedIndex="{Binding FilterIndex}" Width="170" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Kein Wörterbuch für die Zielsprache: mit einem Klick laden -->
        <Border Grid.Row="1" Classes="infobar" Margin="8,8,8,0" IsVisible="{Binding DictionaryMissing}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{StaticResource Ic.Spelling}" Width="18" Height="18" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding DictionaryInfo, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="{l:T 'Wörterbuch laden'}" Command="{Binding DownloadDictionaryCommand}" Margin="10,0,0,0"
                        ToolTip.Tip="{l:T 'Freies Wörterbuch aus dem LibreOffice-Projekt (eigene Lizenz)'}" />
            </Grid>
        </Border>

        <!-- Suchen und Ersetzen -->
        <Border Grid.Row="2" Padding="8,6,8,0" IsVisible="{Binding #FindToggle.IsChecked}">
            <WrapPanel>
                <TextBox Text="{Binding FindText}" PlaceholderText="{l:T 'Suchen im Ziel'}" Width="220" Margin="0,0,6,4" />
                <TextBox Text="{Binding ReplaceText}" PlaceholderText="{l:T 'Ersetzen durch'}" Width="220" Margin="0,0,6,4" />
                <Button Content="{l:T 'Alle ersetzen'}" Command="{Binding ReplaceAllCommand}" Margin="0,0,6,4" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="3" x:Name="Split" ColumnDefinitions="*,Auto,420">
            <Border x:Name="SegmentArea" Classes="card" Padding="0" Margin="8" ClipToBounds="True">
                <DockPanel>
                    <!-- Spaltenköpfe -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderRowBackground}" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="4,6,16,6">
                        <Grid ColumnDefinitions="5,40,*,*,88">
                            <TextBlock Grid.Column="1" Text="#" Classes="muted" FontWeight="SemiBold" Margin="6,0,0,0" />
                            <TextBlock Grid.Column="2" Classes="muted" FontWeight="SemiBold" Margin="8,0">
                                <Run Text="{l:T 'Quelle'}" /><Run Text=" · " /><Run Text="{Binding SourceLanguage}" />
                            </TextBlock>
                            <TextBlock Grid.Column="3" Classes="muted" FontWeight="SemiBold" Margin="8,0">
                                <Run Text="{l:T 'Ziel'}" /><Run Text=" · " /><Run Text="{Binding TargetLanguage}" />
                            </TextBlock>
                            <TextBlock Grid.Column="4" Text="{l:T 'Status'}" Classes="muted" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="SegmentList" ItemsSource="{Binding Segments}" SelectedItem="{Binding Selected}" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="BorderBrush" Value="{DynamicResource RowBorder}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SegmentSelected}" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SegmentSelected}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SegmentViewModel">
                                <Grid ColumnDefinitions="5,40,*,*,88">
                                    <!-- Statusfarbe als schmaler Streifen -->
                                    <Border Background="{Binding StatusBrush}" CornerRadius="2" Margin="0,6" />
                                    <StackPanel Grid.Column="1" Margin="6,8,0,0" Spacing="2">
                                        <TextBlock Text="{Binding Id}" Classes="muted" FontSize="12" />
                                        <TextBlock Text="⚠" Foreground="#C53030" IsVisible="{Binding HasIssues}" ToolTip.Tip="{l:T 'QA-Meldungen'}" />
                                        <TextBlock Text="✎" Classes="muted" IsVisible="{Binding HasComment}" ToolTip.Tip="{Binding Model.Comment}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource SourceBackground}" CornerRadius="4" Margin="4,4,4,4" Padding="2">
                                        <StackPanel>
                                            <c:SegmentTextBox Value="{Binding Source, Mode=OneWay}" IsReadOnly="True" TagData="{Binding TagData}" SpellCheck="False"
                                                              FontFamily="{DynamicResource ContentControlThemeFontFamily}" Background="Transparent" Padding="4,4"
                                                              FontSize="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).EditorFontSize}" />
                                            <TextBlock Text="{Binding Context}" FontSize="11" Classes="muted" Margin="6,0,6,3" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Context, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="{DynamicResource EditorBackground}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="4" Margin="4">
                                        <StackPanel>
                                            <c:SegmentTextBox Value="{Binding Target}" IsReadOnly="{Binding IsReadOnly}" TagData="{Binding TagData}" SourceText="{Binding Source}"
                                                              SpellLanguage="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).TargetLanguage}"
                                                              SpellCheck="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).SpellCheckEnabled}"
                                                              FontSize="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).EditorFontSize}"
                                                              FontFamily="{DynamicResource ContentControlThemeFontFamily}" Background="Transparent" Padding="4,4"
                                                              MinHeight="32" GotFocus="OnTargetFocused" TextChanged="OnTargetTextChanged" />
                                            <TextBlock Text="{Binding MissingTags, Converter={x:Static l:L.Text}}" FontSize="11" Foreground="#C53030" Margin="6,0,6,3"
                                                       IsVisible="{Binding MissingTags, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="4" Margin="6,6,4,0" Spacing="3">
                                        <Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="6,2">
                                            <TextBlock Text="{Binding StatusText, Converter={x:Static l:L.Text}}" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding OriginText, Converter={x:Static l:L.Text}}" FontSize="11" Classes="muted" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LockText, Converter={x:Static l:L.Text}}" FontSize="11" Foreground="#B7791F" HorizontalAlignment="Center" TextWrapping="Wrap"
                                                   IsVisible="{Binding LockText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" ResizeDirection="Columns" />

            <!-- Seitenleiste -->
            <TabControl x:Name="SidePanel" Grid.Column="2" Classes="side" SelectedIndex="{Binding SidePanelTab}" Padding="4" Margin="0,8,8,8"
                        Background="{DynamicResource CardBackground}">
                <TabItem Header="{l:T 'TM'}">
                    <ScrollViewer>
                        <StackPanel Spacing="6">
                            <ItemsControl ItemsSource="{Binding Matches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatchRow">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,4">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock FontWeight="Bold" VerticalAlignment="Center"><Run Text="{l:T 'Strg+'}" /><Run Text="{Binding Number}" /></TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding Score}" Margin="8,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Content="{l:T 'Einsetzen'}" Padding="6,1"
                                                            Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).ApplyMatchCommand}"
                                                            CommandParameter="{Binding Number}" />
                                                </Grid>
                                                <TextBlock c:TagHighlight.Text="{Binding Source}" TextWrapping="Wrap" Classes="muted" />
                                                <TextBlock c:TagHighlight.Text="{Binding Target}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Info, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ContextText, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.5" TextWrapping="Wrap" FontStyle="Italic"
                                                           IsVisible="{Binding ContextText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:T 'Fragment-Treffer'}" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock Text="{l:T 'Kürzere TM-Einträge, die vollständig in diesem Segment vorkommen.'}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Fragments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FragmentRow">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Phrase}" TextWrapping="Wrap" Classes="muted" />
                                                <TextBlock Text="{Binding Target}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="+" VerticalAlignment="Top" ToolTip.Tip="{l:T 'Ins Ziel einfügen'}"
                                                    Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).InsertFragmentCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:T 'Termini'}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" FontSize="11" Classes="muted" TextWrapping="Wrap" Margin="2,6"
                                   Text="{l:T 'Strg+F2: markierten Quelltext und markierten Zieltext als Begriff aufnehmen.'}" />
                        <ListBox ItemsSource="{Binding Terms}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TermRow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Targets}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Definition}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+" VerticalAlignment="Top" ToolTip.Tip="{l:T 'Ins Ziel einfügen'}"
                                                Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).InsertTermCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{l:T 'Konkordanz'}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="4">
                            <TextBox Text="{Binding ConcordanceQuery}" PlaceholderText="{l:T 'Ausdruck (F3: markierten Text suchen)'}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="{l:T 'im Ziel suchen'}" IsChecked="{Binding ConcordanceInTarget}" />
                                <Button Content="{l:T 'Suchen'}" Command="{Binding SearchConcordanceCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Concordance}" Margin="0,6,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConcordanceRow">
                                    <StackPanel Spacing="1">
                                        <TextBlock c:TagHighlight.Text="{Binding Source}" TextWrapping="Wrap" Classes="muted" />
                                        <TextBlock c:TagHighlight.Text="{Binding Target}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Info, Converter={x:Static l:L.Text}}" FontSize="11" Opacity="0.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{l:T 'QA'}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <Button Content="{l:T 'Dokument prüfen'}" Command="{Binding RunQaCommand}" />
                            <Button Content="{l:T 'Rechtschreibung (Segment)'}" Command="{Binding CheckSpellingCommand}" />
                        </StackPanel>
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SpellingErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpellRow">
                                    <StackPanel Margin="0,0,0,6" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Word}" FontWeight="SemiBold" Foreground="#C53030" VerticalAlignment="Center" />
                                            <Button Content="{l:T 'ins Wörterbuch'}" Padding="6,1" FontSize="12"
                                                    Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).AddToDictionaryCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Suggestions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SuggestionItem">
                                                    <Button Content="{Binding Replacement}" Padding="6,1" Margin="0,0,4,4" FontSize="12"
                                                            Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).ApplySpellingCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ListBox ItemsSource="{Binding QaIssues}" x:Name="QaList" DoubleTapped="OnQaDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:QaRow">
                                    <StackPanel Spacing="1">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding SegmentId, StringFormat='Segment {0}'}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Severity, Converter={x:Static l:L.Text}}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Check, Converter={x:Static l:L.Text}}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{l:T 'Wissen'}">
                    <ScrollViewer>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{l:T 'Passendes aus den Wissensdatenbanken – geht auch in jede KI-Übersetzung ein.'}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Knowledge}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KnowledgeRow">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Header, Converter={x:Static l:L.Text}}" FontSize="11" Classes="muted" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:T 'Notiz'}">
                    <ScrollViewer>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{l:T 'Kommentar zum Segment'}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                            <TextBlock Text="{l:T 'Verlauf'}" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="{l:T 'Jede bestätigte Fassung; Änderungen als [−gelöscht−] {+eingefügt+}.'}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryRow">
                                        <StackPanel Margin="0,4" Spacing="1">
                                            <TextBlock Text="{Binding Header, Converter={x:Static l:L.Text}}" FontSize="11" Classes="muted" />
                                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <SelectableTextBlock Text="{Binding Diff}" TextWrapping="Wrap" FontSize="12" Foreground="#2B6CB0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:T 'KI'}">
                    <ScrollViewer>
                        <StackPanel Spacing="6">
                            <WrapPanel>
                                <Button Content="{l:T 'Übersetzen'}" Command="{Binding AiTranslateCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Varianten bewerten'}" ToolTip.Tip="{l:T 'Strg+Umschalt+E: aktuelle Übersetzung, TM-Treffer und KI-Vorschlag vergleichen'}"
                                        Command="{Binding EvaluateSegmentCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Usus prüfen'}" ToolTip.Tip="{l:T 'Strg+Umschalt+U: markierten Zieltext (oder ganze Übersetzung) im Netz prüfen'}"
                                        Command="{Binding CheckUsageOfTargetCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Beste übernehmen'}" Command="{Binding UseBestEvaluatedCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Begriff im Kontext klären'}" Click="OnClarifyTermClick" Margin="0,0,6,4"
                                        ToolTip.Tip="{l:T 'Strg+Umschalt+B: markierten Begriff im Quelltext auf Fachseiten beider Sprachen vergleichen'}" />
                            </WrapPanel>
                            <WrapPanel IsVisible="{Binding HasComparison}">
                                <Button Content="{l:T 'Empfehlung → Terminologie'}" Command="{Binding SaveComparisonToTermbaseCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Begründung → Wissen'}" Command="{Binding SaveComparisonToKnowledgeCommand}" Margin="0,0,6,4" />
                            </WrapPanel>
                            <CheckBox Content="{l:T 'Fragliche Wendungen beim Bewerten im Netz prüfen'}" IsChecked="{Binding AiCheckUsage}" />
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsAiRunning}" />
                            <SelectableTextBlock Text="{Binding AiResult, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" />
                            <Expander Header="{l:T 'Protokoll'}">
                                <SelectableTextBlock Text="{Binding AiLog, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" FontSize="12" Classes="muted" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- AutoSuggest -->
        <Popup x:Name="SuggestPopup" Grid.Row="3" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="2">
                <ListBox x:Name="SuggestList" MaxHeight="220" MinWidth="200" Tapped="OnSuggestionTapped" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
