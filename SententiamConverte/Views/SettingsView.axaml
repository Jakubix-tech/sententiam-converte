<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:SententiamConverte.Services"
             xmlns:vm="using:SententiamConverte.ViewModels"
             xmlns:ai="using:SententiamConverte.Core.Ai"
             x:Class="SententiamConverte.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="{l:T 'Einstellungen'}" Classes="h1" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{l:T 'Sprache der Oberfläche'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding UiLanguageNames}" SelectedIndex="{Binding UiLanguageIndex}" MinWidth="180" />
                <TextBlock Text="{Binding UiLanguageInfo}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>


            <!-- KI-Zugänge, Aufgabenverteilung und Websuche stehen auf der eigenen Seite „KI einrichten“ -->
            <Border Classes="card">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource Ic.Ai}" Width="22" Height="22" Foreground="{DynamicResource SystemAccentColor}" />
                    <TextBlock Text="{l:T 'KI-Zugänge, Aufgabenverteilung und Websuche stehen auf der Seite „KI einrichten“.'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="{l:T 'KI einrichten öffnen'}" Command="{Binding OpenAiPageCommand}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{l:T 'Fachquellen je Thema'}" Classes="h2" />
                    <TextBlock TextWrapping="Wrap" Classes="muted"
                               Text="{l:T 'Auf diese Seiten beschränken die Agenten ihre Suche (findet sich dort nichts, wird allgemein gesucht). Je Zeile: Sprache | System (z. B. Rechtsordnung) | Domains, mit Komma getrennt. „*“ gilt für alle Sprachen. Das Profil wird pro Projekt gewählt.'}" />
                    <Grid ColumnDefinitions="200,16,*">
                        <StackPanel Spacing="6">
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Height="160">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProfileViewModel">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel>
                                <Button Content="{l:T 'Neu'}" Command="{Binding AddProfileCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Entfernen'}" Command="{Binding RemoveProfileCommand}" Margin="0,0,6,4" />
                                <Button Content="{l:T 'Vorschläge'}" Command="{Binding ResetProfilesCommand}" Margin="0,0,6,4" ToolTip.Tip="{l:T 'Mitgelieferte Profile wiederherstellen'}" />
                                <Button Content="{l:T 'Fachseiten prüfen'}" Command="{Binding CheckProfileSitesCommand}" Margin="0,0,6,4"
                                        ToolTip.Tip="{l:T 'Erlauben die Seiten das automatische Lesen (robots.txt, Nutzungsvorbehalte), und liefern sie lesbaren Text?'}" />
                            </WrapPanel>
                            <SelectableTextBlock Text="{Binding ProfileCheckResult, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6" DataContext="{Binding SelectedProfile}" x:DataType="vm:ProfileViewModel">
                            <TextBox Text="{Binding Name}" PlaceholderText="{l:T 'Thema, z. B. Recht'}" />
                            <TextBox Text="{Binding Description}" PlaceholderText="{l:T 'Beschreibung'}" />
                            <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="150" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{l:T 'Teamserver'}" Classes="h2" />
                    <TextBlock TextWrapping="Wrap" Classes="muted"
                               Text="{l:T 'Über einen eigenen Teamserver teilen mehrere Übersetzer TMs, Terminologien und Wissensdatenbanken – gleichzeitig und sofort sichtbar. Den Zugangsschlüssel erhält jeder vom Server-Admin. Im Internet nur über HTTPS betreiben.'}" />
                    <Grid ColumnDefinitions="220,16,*">
                        <StackPanel Spacing="6">
                            <ListBox ItemsSource="{Binding ServerAccounts}" SelectedItem="{Binding SelectedServer}" Height="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServerAccountViewModel">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{l:T 'Hinzufügen'}" Command="{Binding AddServerCommand}" />
                                <Button Content="{l:T 'Entfernen'}" Command="{Binding RemoveServerCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6" DataContext="{Binding SelectedServer}" x:DataType="vm:ServerAccountViewModel">
                            <TextBox Text="{Binding Name}" PlaceholderText="{l:T 'Name, z. B. Büro'}" />
                            <TextBox Text="{Binding Url}" PlaceholderText="{l:T 'Adresse, z. B. https://server.firma.de'}" />
                            <TextBox Text="{Binding Token}" PlaceholderText="{l:T 'Zugangsschlüssel oder env:VARIABLE'}" PasswordChar="•" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:T 'Verbindung testen'}" Command="{Binding TestServerCommand}" />
                    </StackPanel>
                    <Expander Header="{l:T 'Ressource auf dem Server anlegen (nur Admin)'}">
                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding ResourceKindNames}" SelectedIndex="{Binding NewResourceKind}" Width="190" Margin="0,0,8,4" />
                            <TextBox Text="{Binding NewResourceName}" PlaceholderText="{l:T 'Name'}" Width="200" Margin="0,0,8,4" />
                            <TextBox Text="{Binding NewResourceDescription}" PlaceholderText="{l:T 'Beschreibung'}" Width="260" Margin="0,0,8,4" />
                            <Button Content="{l:T 'Anlegen'}" Command="{Binding CreateServerResourceCommand}" Margin="0,0,8,4" />
                        </WrapPanel>
                    </Expander>
                    <SelectableTextBlock Text="{Binding ServerResult, Converter={x:Static l:L.Text}}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Aus Korrekturen lernen -->
            <Border Classes="card" DataContext="{Binding Learning}" x:DataType="vm:LearningViewModel">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:T 'Aus Korrekturen lernen'}" Classes="h2" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="{l:T 'Das Programm vergleicht beim Bestätigen Ihre Übersetzung mit dem Vorschlag von KI, MÜ oder TM. Ändern Sie dieselbe Stelle wiederholt gleich, schlägt es eine Regel vor; bestätigte Regeln bekommt die KI als Vorgabe, und die QA meldet Abweichungen. Änderungen nur der Anrede oder des Geschlechts werden keine Regel, sondern passen den Steckbrief des Dokuments an. Bestätigte Steckbriefe merken sich Anrede und Sprecher je Kunde und Textsorte.'}" />
                    <CheckBox Content="{l:T 'Aus Korrekturen lernen'}" IsChecked="{Binding Enabled}" />
                    <TextBlock Text="{l:T 'Noch keine Regeln – sie entstehen, sobald sich eine Korrektur wiederholt.'}" Classes="muted"
                               IsVisible="{Binding !Rules.Count}" />
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LearnedRuleRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Info}" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{l:T 'Aktivieren'}" Command="{Binding Owner.ActivateCommand}" CommandParameter="{Binding}"
                                            IsVisible="{Binding CanActivate}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="{l:T 'Entfernen'}" Command="{Binding Owner.RemoveCommand}" CommandParameter="{Binding}"
                                            Margin="6,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Automatisierung: überwachte Ordner -->
            <Border Classes="card" DataContext="{Binding Automation}" x:DataType="vm:AutomationViewModel">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:T 'Automatisierung: überwachte Ordner'}" Classes="h2" />
                    <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                               Text="{l:T 'Neue Dateien im Eingangsordner kommen automatisch ins gewählte Projekt, werden aus dem TM vorübersetzt (auf Wunsch leere Segmente per KI, als Entwurf), die Zieldateien landen im Ausgangsordner (je Zielsprache), das Original wandert nach „erledigt“. Bestätigt wird nichts – die Übersetzung bleibt zum Prüfen im Projekt. Geprüft wird alle 10 Sekunden, solange das Programm läuft.'}" />
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WatchRuleViewModel">
                                <Border Padding="10" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="140,*,Auto">
                                            <TextBlock Text="{l:T 'Eingangsordner'}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Folder}" />
                                            <Button Grid.Column="2" Content="…" Margin="6,0,0,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:AutomationViewModel)DataContext).PickFolderCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="140,*">
                                            <TextBlock Text="{l:T 'Projekt'}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[ItemsControl].((vm:AutomationViewModel)DataContext).ProjectFolders}"
                                                      SelectedItem="{Binding ProjectFolder}" HorizontalAlignment="Stretch" />
                                        </Grid>
                                        <Grid ColumnDefinitions="140,*,Auto">
                                            <TextBlock Text="{l:T 'Ausgangsordner'}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding OutputFolder}" PlaceholderText="{l:T 'leer = Unterordner „fertig“ im Eingangsordner'}" />
                                            <Button Grid.Column="2" Content="…" Margin="6,0,0,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:AutomationViewModel)DataContext).PickOutputCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <WrapPanel>
                                            <CheckBox Content="{l:T 'aktiv'}" IsChecked="{Binding Enabled}" Margin="0,0,14,0" FontWeight="SemiBold" />
                                            <CheckBox Content="{l:T 'aus dem TM vorübersetzen'}" IsChecked="{Binding Pretranslate}" Margin="0,0,14,0" />
                                            <CheckBox Content="{l:T 'leere Segmente per KI'}" IsChecked="{Binding AiTranslate}" Margin="0,0,14,0" />
                                            <CheckBox Content="{l:T 'Zieldateien ausgeben'}" IsChecked="{Binding ExportTargets}" Margin="0,0,14,0" />
                                            <Button Content="{l:T 'Entfernen'}"
                                                    Command="{Binding $parent[ItemsControl].((vm:AutomationViewModel)DataContext).RemoveRuleCommand}" CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:T 'Ordner hinzufügen'}" Command="{Binding AddRuleCommand}" />
                        <Button Content="{l:T 'Jetzt prüfen'}" Command="{Binding CheckCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Log}" MaxHeight="160">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <SelectableTextBlock Text="{Binding Converter={x:Static l:L.Text}}" FontSize="12" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding LocalApiAvailable}">
                <StackPanel Spacing="10">
                        <TextBlock Text="{l:T 'Schnittstelle (API)'}" Classes="h2" />
                        <TextBlock TextWrapping="Wrap" Classes="muted"
                                   Text="{l:T 'Über die REST-Schnittstelle können eigene Skripte und andere Programme alle Funktionen nutzen: Projekte, Dateien, Segmente, Vorübersetzung, Analyse, QA, TM, Terminologie, Wissen, Agenten und Erweiterungen. Sie ist nur auf diesem Rechner erreichbar (127.0.0.1) und verlangt den Zugangsschlüssel (Kopfzeile „Authorization: Bearer …“). Für mehrere Personen den Teamserver verwenden – er bietet dieselbe Schnittstelle.'}" />
                        <WrapPanel>
                            <CheckBox Content="{l:T 'Lokale API einschalten'}" IsChecked="{Binding LocalApiEnabled}" Margin="0,0,16,4" />
                            <TextBlock Text="{l:T 'Port'}" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <NumericUpDown Value="{Binding LocalApiPort}" Minimum="1024" Maximum="65535" FormatString="0" Width="130" Margin="0,0,16,4" />
                        </WrapPanel>
                        <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                            <TextBox Text="{Binding LocalApiToken}" PlaceholderText="{l:T 'Zugangsschlüssel'}" PasswordChar="•" RevealPassword="{Binding #ShowApiToken.IsChecked}" />
                            <CheckBox Grid.Column="2" x:Name="ShowApiToken" Content="{l:T 'Anzeigen'}" />
                            <Button Grid.Column="4" Content="{l:T 'Neuer Schlüssel'}" Command="{Binding NewApiTokenCommand}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{l:T 'Übernehmen'}" Command="{Binding ApplyLocalApiCommand}" />
                            <SelectableTextBlock Text="{Binding LocalApiStatus, Converter={x:Static l:L.Text}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{l:T 'Rechtschreibprüfung'}" Classes="h2" />
                    <TextBlock TextWrapping="Wrap" Classes="muted"
                               Text="{l:T 'Wörterbücher werden nicht mitgeliefert, sondern auf Wunsch aus dem freien LibreOffice-Wörterbuchprojekt geladen. Es gilt die Lizenz des jeweiligen Wörterbuchs (meist GPL, LGPL oder MPL).'}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding DictionaryLanguages}" SelectedItem="{Binding DictionaryLanguage}" MinWidth="140" />
                        <Button Content="{l:T 'Wörterbuch laden'}" Command="{Binding DownloadDictionaryCommand}" />
                        <TextBlock Text="{Binding DictionaryStatus, Converter={x:Static l:L.Text}}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
