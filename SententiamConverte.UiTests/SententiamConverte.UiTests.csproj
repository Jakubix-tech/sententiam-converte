<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" VersionOverride="3.2.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\SententiamConverte\SententiamConverte.csproj" />
    <ProjectReference Include="..\SententiamConverte.Server\SententiamConverte.Server.csproj" />
    <ProjectReference Include="..\SententiamConverte.Desktop\SententiamConverte.Desktop.csproj" />
    <!-- Beispiel-Erweiterung mitbauen und ihr Paket neben die Tests legen -->
    <ProjectReference Include="..\Erweiterungen\Beispiel.Erweiterung\Beispiel.Erweiterung.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\Erweiterungen\Beispiel.Erweiterung\bin\$(Configuration)\net10.0\Beispiel.Erweiterung.scext" Link="Beispiel.Erweiterung.scext" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
